{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out-test",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "test/features.test.ts",
    "test/cli.test.ts",
    "test/present.test.ts",
    "test/extensionCore.test.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "out-test",
    "test/integration"
  ]
}
